  "item": [
    {
      "name": "1. Добавить лайк",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Должен вернуть 201 Created\", function () {",
              "    pm.response.to.have.status(201);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/users/{{userId}}/events/{{eventId}}/rating?ratingType=LIKE",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "users",
            "{{userId}}",
            "events",
            "{{eventId}}",
            "rating"
          ],
          "query": [
            {
              "key": "ratingType",
              "value": "LIKE"
            }
          ]
        }
      },
      "response": []
    },
