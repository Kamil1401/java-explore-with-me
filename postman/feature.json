    {
      "name": "3. Подготовить дату (+1 день)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "let d = new Date();",
              "d.setDate(d.getDate() + 1);",
              "let formatted = d.getFullYear() + '-' +",
              "('0' + (d.getMonth()+1)).slice(-2) + '-' +",
              "('0' + d.getDate()).slice(-2) + ' 12:00:00';",
              "pm.collectionVariables.set('eventDate', formatted);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
