    {
      "name": "5. Получить событие и проверить рейтинг",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Ответ содержит лайки и дизлайки\", function () {",
              "    pm.response.to.have.status(200);",
              "    const body = pm.response.json();",
              "    pm.expect(body).to.have.property('likes');",
              "    pm.expect(body).to.have.property('dislikes');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
